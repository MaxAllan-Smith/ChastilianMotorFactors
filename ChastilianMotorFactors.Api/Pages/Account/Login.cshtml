@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="ReturnUrl"/>

    <label asp-for="Input.Email"></label>
    <input asp-for="Input.Email" autocomplete="username"/>
    <span asp-validation-for="Input.Email"></span>

    <label asp-for="Input.Password"></label>
    <input asp-for="Input.Password" autocomplete="current-password"/>
    <span asp-validation-for="Input.Password"></span>

    <label class="checkbox">
        <input asp-for="Input.RememberMe"/> Remember me
    </label>

    <button type="submit">Sign in</button>
</form>

<p>No account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>.</p>